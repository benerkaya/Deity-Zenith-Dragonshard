local GONE = 'Game closed or detached. Deity Zenith switched off without touching game memory.'

local function al() return getAddressList() end
local function rootRec()
  if memrec ~= nil then S.root = memrec end
  if S.root == nil then S.root = al().getMemoryRecordByDescription('Deity Zenith - Enable') end
  return S.root
end
local function status(text)
  S.statusText = text
  local r = S.statusRec or al().getMemoryRecordByID(S.STATUS_ID)
  S.statusRec = r
  if r then pcall(function() r.Description = 'Status: ' .. text end) end
end

local function bytesAt(a, n)
  local ok, t = pcall(readBytes, a, n, true)
  if not ok or type(t) ~= 'table' then return nil end
  return t
end
local function same(t, want)
  if t == nil then return false end
  for i = 1, #want do if t[i] ~= want[i] then return false end end
  return true
end
-- code bytes are written through Auto Assembler, which makes the code page writable for the write
local function writeCode(addr, bytes)
  local parts = {}
  for i = 1, #bytes do parts[i] = string.format('%02X', bytes[i]) end
  local ok, r = pcall(autoAssemble, string.format('%08X:\ndb %s\n', addr, table.concat(parts, ' ')))
  if not ok then return false, tostring(r) end
  if r ~= true then return false, 'Auto Assembler refused the write' end
  return true
end
local function jmpBytes(from, to)
  local rel = (to - (from + 5)) % 0x100000000
  return {0xE9, rel % 256, (rel &gt;&gt; 8) % 256, (rel &gt;&gt; 16) % 256, (rel &gt;&gt; 24) % 256}
end

-- Dialog-free liveness probe: PID compare, CE symbol lookup and one pcall'd canary read of our own block.
local function processAlive()
  local pid = getOpenedProcessID()
  if pid == nil or pid == 0 or S.pid == nil or pid ~= S.pid then return false end
  if S.mem == nil or getAddressSafe(MEMSYM) ~= S.mem then return false end
  local ok, v = pcall(readInteger, S.mem)
  return ok and v == MAGIC
end
S.processAlive = processAlive

-- Run in Background. On focus loss (WM_ACTIVATEAPP false) the game's focus handler releases its mouse clip, clears
-- its "window active" flag (+0x461), which skips all drawing and per-frame updates, and in single player also sets
-- the pause flag, pauses sound and music and stops its frame loop (+0x460). While this toggle is on, the handler is
-- changed in memory so that focus loss only releases the mouse clip and nothing else; coming back re-applies the
-- clip. If the game was stopped by the original code (for example before this was switched on), coming back runs
-- the game's own resume code as normal. Two spans of the same function, checked byte for byte and put back when the
-- row is Off or on Disable. The game is suspended for the moment of each write.
local BG = {
  {addr = 0x005CD012,   -- function start: compare/store the active flags, return if unchanged
   orig  = {0x38,0x87,0x60,0x04,0x00,0x00, 0x88,0x87,0x61,0x04,0x00,0x00, 0x0F,0x84,0xA6,0x00,0x00,0x00},
   patch = {0x84,0xC0, 0x74,0x5B, 0x80,0xBF,0x60,0x04,0x00,0x00,0x00, 0x75,0x5A, 0x0F,0x1F,0x44,0x00,0x00}},
  {addr = 0x005CD078,   -- after the clip release on focus loss: network check, pause flag save, jne
   orig  = {0x39,0x1D,0x10,0xFF,0xE6,0x00, 0xA0,0xC0,0x8F,0xE6,0x00, 0xA2,0x5D,0x4A,0x06,0x01, 0x75,0x29},
   old   = {0x39,0x1D,0x10,0xFF,0xE6,0x00, 0xA0,0xC0,0x8F,0xE6,0x00, 0xA2,0x5D,0x4A,0x06,0x01, 0xEB,0x29},
   patch = {0xC3, 0xC6,0x87,0x61,0x04,0x00,0x00,0x01, 0x56, 0x8B,0xF7, 0xE8,0x52,0x00,0x00,0x00, 0x5E, 0xC3}},
}
local HEAD, TAIL = BG[1], BG[2]
-- true = changed, false = original, nil = bytes from somewhere else (left alone)
local function bgState()
  local h, t = bytesAt(HEAD.addr, #HEAD.orig), bytesAt(TAIL.addr, #TAIL.orig)
  if same(h, HEAD.patch) and same(t, TAIL.patch) then return true end
  if same(h, HEAD.orig) and same(t, TAIL.orig) then return false end
  if same(h, HEAD.orig) and same(t, TAIL.old) then return 'old' end   -- left by an earlier copy of this table
  return nil
end
local function setBackground(want)
  local st = bgState()
  if st == nil then return nil end
  local ok = true
  if want and st ~= true then
    pause()
    ok = writeCode(TAIL.addr, TAIL.patch) and writeCode(HEAD.addr, HEAD.patch)   -- tail first: the head is what reaches it
    unpause()
  elseif not want and st ~= false then
    pause()
    ok = writeCode(HEAD.addr, HEAD.orig) and writeCode(TAIL.addr, TAIL.orig)
    unpause()
  end
  st = bgState()
  if st == true or st == false then return st end
  return nil
end
-- Run in Background, sound. Windows' DirectSound mutes a program's sounds while another window is in front, unless
-- they were created as "global" sounds; the game creates all of its sound voices once at start-up without that
-- (it has the option, hard-coded off). DirectSound decides this in its own focus thread, which asks Windows for the
-- foreground window (GetForegroundWindow) and whether that window is minimised (GetWindowPlacement), through
-- dsound.dll's import table in this game process. While the toggle is on, those two entries point at two tiny
-- answers in this table's own memory block: "the game window" and "not minimised". Only DirectSound in this game
-- process asks them; the game itself does not import GetForegroundWindow. Pointers are put back when Off or on Disable.
local SND_FG_OFF, SND_WP_OFF = 0xF00, 0xF10
local SND_FG_CODE = {0xA1, 0xEC, 0x6C, 0xE6, 0x00, 0xC3}                                  -- mov eax,[0xE66CEC] (game window); ret
local SND_WP_CODE = {0x8B, 0x44, 0x24, 0x08, 0xC7, 0x40, 0x08, 0x01, 0x00, 0x00, 0x00,     -- mov eax,[esp+8]; showCmd = SW_SHOWNORMAL
                     0xB8, 0x01, 0x00, 0x00, 0x00, 0xC2, 0x08, 0x00}                      -- mov eax,1; ret 8
local function rd32(a) local v = readInteger(a); if v == nil then return nil end; return v % 0x100000000 end
local function cstr(a, n)
  local t = bytesAt(a, n or 64); if not t then return nil end
  local c = {}
  for k = 1, #t do if t[k] == 0 then break end; c[#c + 1] = string.char(t[k]) end
  return table.concat(c)
end
-- find the import-table slot of a user32 window function in a loaded module (delay-load table first, then the normal one)
local function importSlot(base, fname)
  local pe = base + (rd32(base + 0x3C) or 0)
  if rd32(pe) ~= 0x4550 then return nil end
  local function scan(dir, step, nameOff, iatOff, intOff)
    local rva = rd32(pe + 0x78 + dir * 8)
    if not rva or rva == 0 then return nil end
    for d = 0, 63 do
      local desc = base + rva + d * step
      local nrva = rd32(desc + nameOff)
      if not nrva or nrva == 0 then return nil end
      if dir == 13 and (rd32(desc) or 0) % 2 == 0 then return nil end   -- old-style (VA based) delay table: not used by dsound.dll
      local dll = (cstr(base + nrva) or ''):lower()
      if dll == 'user32.dll' or dll:find('^ext%-ms%-win%-ntuser%-window') or dll:find('^api%-ms%-win%-ntuser') then
        local iat, int = rd32(desc + iatOff), rd32(desc + intOff)
        if int == nil or int == 0 then int = iat end
        for k = 0, 1023 do
          local e = rd32(base + int + k * 4)
          if not e or e == 0 then break end
          if e &lt; 0x80000000 and cstr(base + e + 2) == fname then return base + iat + k * 4 end
        end
      end
    end
    return nil
  end
  return scan(13, 32, 4, 12, 16) or scan(1, 20, 12, 16, 0)
end
S.importSlot = importSlot
local function soundSlots()
  local base = getAddressSafe('dsound.dll')
  if not base or base == 0 then return nil end
  local fg, wp = importSlot(base, 'GetForegroundWindow'), importSlot(base, 'GetWindowPlacement')
  if not fg or not wp then return nil end
  local size = rd32(base + (rd32(base + 0x3C) or 0) + 0x50) or 0
  return {base = base, size = size, {slot = fg, stub = S.mem + SND_FG_OFF, code = SND_FG_CODE, api = 'user32.GetForegroundWindow'},
                                    {slot = wp, stub = S.mem + SND_WP_OFF, code = SND_WP_CODE, api = 'user32.GetWindowPlacement'}}
end
local function inModule(v, name)
  local b = getAddressSafe(name)
  if not b or b == 0 then return false end
  local size = rd32(b + (rd32(b + 0x3C) or 0) + 0x50) or 0
  return v &gt;= b and v &lt; b + size
end
local function ptrBytes(v) return {v % 256, (v &gt;&gt; 8) % 256, (v &gt;&gt; 16) % 256, (v &gt;&gt; 24) % 256} end
-- true = changed, false = original, nil = not available (no dsound.dll, slot pointing somewhere unknown, write refused)
local function setSound(want)
  local ss = soundSlots()
  if not ss then return nil end
  S.sndOrig = S.sndOrig or {}
  local state = {}
  for k, e in ipairs(ss) do
    local v = rd32(e.slot)
    if v == nil then return nil end
    local real = getAddressSafe(e.api)
    if v == e.stub then state[k] = 'stub'
    elseif (v &gt;= ss.base and v &lt; ss.base + ss.size) or (real and v == real) or inModule(v, 'user32.dll') or inModule(v, 'win32u.dll') then
      state[k] = 'clean'; S.sndOrig[k] = v
    else return nil end                                  -- someone else's pointer: left alone
  end
  for k, e in ipairs(ss) do
    if want and state[k] == 'clean' then
      if not same(bytesAt(e.stub, #e.code), e.code) then
        if not writeCode(e.stub, e.code) or not same(bytesAt(e.stub, #e.code), e.code) then return nil end
      end
      if not writeCode(e.slot, ptrBytes(e.stub)) then return nil end
    elseif not want and state[k] == 'stub' then
      local back = S.sndOrig[k] or getAddressSafe(e.api)
      if not back or back == 0 then return nil end
      if not writeCode(e.slot, ptrBytes(back)) then return nil end
    end
  end
  local n = 0
  for _, e in ipairs(ss) do if rd32(e.slot) == e.stub then n = n + 1 end end
  if n == #ss then return true elseif n == 0 then return false end
  return nil
end
S.setSound = setSound
local function updateBackground()
  local want = (readInteger(S.mem + O.uiBg) or 0) == 0   -- 0 = On (default), 1 = Off
  local on = setBackground(want)
  local snd = setSound(want)
  local key = tostring(want) .. '/' .. tostring(on) .. '/' .. tostring(snd)
  if key ~= S.bgOn then
    local first = (S.bgOn == 'unset')
    S.bgOn = key
    writeInteger(S.mem + O.bgState, on == true and 1 or (on == false and 0 or 2))
    writeInteger(S.mem + O.sndState, snd == true and 1 or (snd == false and 0 or 2))
    if not first then
      if on == true and snd == true then status('Run in Background on: the game and its sound keep running while you are in another window.')
      elseif on == true then status('Run in Background on: the game keeps running while you are in another window, but its sound could not be kept on.')
      elseif on == false then status('Run in Background off: the game pauses when you switch to another window, as normal.')
      elseif want then status('Run in Background is not available: that game code is changed by another tool.') end
    end
  end
end

local function stopEvents()
  if S.timer then local t = S.timer; S.timer = nil; pcall(function() t.Enabled = false; t.destroy() end) end
  if S.hotkey then local h = S.hotkey; S.hotkey = nil; pcall(function() h.destroy() end) end
  if S.lvHotkey then local h = S.lvHotkey; S.lvHotkey = nil; pcall(function() h.destroy() end) end
end

-- local player (static addresses, no ASLR in this exe)
local NET_MODE, LOCAL_PID, PLAYER_ARRAY, PLAYER_STRIDE = 0x00E67940, 0x00E6AE28, 0x00E6AD94, 0x380
local RESOURCES = {{id=S.RES_IDS and S.RES_IDS[1] or 51, name='Gold', off=0x168},
                   {id=S.RES_IDS and S.RES_IDS[2] or 52, name='Dragonshards', off=0x164},
                   {id=S.RES_IDS and S.RES_IDS[3] or 53, name='XP', off=0x174}}
-- ---Resources---: the Gold / Dragonshards / XP rows point straight at the local player's floats
-- (player slot = [0xE6AD94] + id * 0x380, id = [0xE6AE28]; +0x168 gold, +0x164 shards, +0x174 experience).
-- The address is re-checked on every timer tick; while there is no valid local player (menus, loading, multiplayer)
-- the rows point at a harmless placeholder inside our own block and say so.
local function localPlayer()
  if readInteger(NET_MODE) ~= 0 then return nil, 'multiplayer: off' end
  local id = readInteger(LOCAL_PID)
  if id == nil or id &lt; 0 or id &gt; 7 then return nil, 'not in a battle' end
  local arr = readInteger(PLAYER_ARRAY)
  if arr == nil or arr == 0 then return nil, 'not in a battle' end
  arr = arr % 0x100000000
  if arr &lt; 0x10000 then return nil, 'not in a battle' end
  local p = arr + id * PLAYER_STRIDE
  if readInteger(p + 0xF4) ~= id then return nil, 'not in a battle' end   -- the slot stores its own player id
  for _, r in ipairs(RESOURCES) do
    local v = readFloat(p + r.off)
    if v == nil then return nil, 'not in a battle' end
  end
  return p
end
S.localPlayer = localPlayer
local function updateResources()
  local recs = S.resRecs
  if recs == nil then
    recs = {}
    for i, r in ipairs(RESOURCES) do recs[i] = al().getMemoryRecordByID(r.id) end
    S.resRecs = recs
  end
  local p, why = localPlayer()
  local key = p and string.format('%X', p) or ('none:' .. tostring(why))
  if key ~= S.resKey then
    S.resKey = key
    for i, r in ipairs(RESOURCES) do
      local rec = recs[i]
      if rec then pcall(function()
        if rec.Active then rec.Active = false end   -- never carry a frozen value over to a different address
        if p then rec.Address = string.format('%08X', p + r.off); rec.Description = r.name
        else rec.Address = string.format('%08X', S.mem + O.resPlaceholder + (i - 1) * 4); rec.Description = r.name .. ' (' .. why .. ')' end
      end) end
    end
  end
  if p then
    -- never leave a negative or NaN value in the game (a typo in the value box); the game clamps the top itself
    for _, r in ipairs(RESOURCES) do
      local v = readFloat(p + r.off)
      if v ~= nil and (v ~= v or v &lt; 0) then writeFloat(p + r.off, 0) end
    end
  end
end
-- CE-side only: unfreeze the resource rows and point them at nothing (no game access)
local function parkResources(why)
  local recs = S.resRecs
  S.resKey = nil
  if recs == nil then return end
  for i, r in ipairs(RESOURCES) do
    local rec = recs[i]
    if rec then pcall(function() rec.Active = false; rec.Address = '0'; rec.Description = r.name .. ' (' .. why .. ')' end) end
  end
end

-- Process is gone or changed: CE-side cleanup only. No reads/writes, no hook restore, no dialogs.
local function abandon(text)
  S.enabled = false
  stopEvents()
  pcall(unregisterSymbol, MEMSYM)
  S.mem = nil; S.pid = nil; S.want = false; S.wantLv = false; S.lastFK = nil
  parkResources('switch on Enable first')
  local r = rootRec()
  if r and r.Active then pcall(function() r.disableWithoutExecute() end) end
  status(text)
end
S.abandon = abandon

local function disable(text)
  if S.disabling then return end
  if S.mem == nil then stopEvents(); parkResources('switch on Enable first'); S.enabled = false; status(text or 'Off.'); return end
  if not processAlive() then abandon(GONE); return end
  S.disabling = true
  S.enabled = false
  stopEvents()
  parkResources('switch on Enable first')
  local err = nil
  local ok, e = pcall(function()
    writeInteger(S.mem + O.enabled, 0)
    setBackground(false)
    local sndOff = setSound(false)
    S.bgOn = 'unset'
    writeInteger(S.mem + O.bgState, bgState() == false and 0 or 2)
    writeInteger(S.mem + O.sndState, sndOff == false and 0 or 2)
    local cur = bytesAt(HOOK, 5)
    if same(cur, jmpBytes(HOOK, S.mem + CODE_OFF)) then
      pause()
      local okw, ew = writeCode(HOOK, HOOK_ORIG)
      unpause()
      if not okw then error(ew) end
      if not same(bytesAt(HOOK, 5), HOOK_ORIG) then error('could not restore the original game code') end
    end
  end)
  if not ok then err = tostring(e) end
  S.disabling = false
  S.lastFK = nil
  -- the small code block stays allocated (a frame may still be inside it); it is reused on the next Enable
  status(err and ('Disable problem: ' .. err) or (text or 'Off. Original game code restored.'))
end
S.disable = disable

-- Faction -&gt; Unit/Building -&gt; item picker: the Summon row's list is rebuilt when Faction or Category changes.
local function listFor(f, k)
  if k == 2 then return ITEMLIST end         -- items are not tied to a faction: the same list under every faction
  local l = LISTS[f] and LISTS[f][k]
  return l or {}
end
local function refreshPicker(force)
  local m = S.mem
  local f = readInteger(m + O.uiFaction) or 0
  local k = readInteger(m + O.uiKind) or 0
  if LISTS[f] == nil then f = 0; writeInteger(m + O.uiFaction, 0) end
  if k ~= 0 and k ~= 1 and k ~= 2 then k = 0; writeInteger(m + O.uiKind, 0) end
  local key = f * 3 + k
  if not force and S.lastFK == key then return end
  S.lastFK = key
  local l = listFor(f, k)
  local lines = {}
  for i = 1, #l do lines[i] = l[i] .. ':' .. ITEMS[l[i] + 1].l end
  if #l == 0 then lines[1] = '-1:(none for this faction - pick Unit)' end
  local cur = readInteger(m + O.uiItem)
  local okItem = false
  for i = 1, #l do if l[i] == cur then okItem = true; break end end
  if not okItem then writeInteger(m + O.uiItem, (#l &gt; 0) and l[1] or -1) end
  local r = S.itemRec or al().getMemoryRecordByID(S.ITEM_ID)
  S.itemRec = r
  if r then pcall(function()
    r.DropDownList.Text = table.concat(lines, '\n')
    r.DropDownReadOnly = true; r.DropDownDescriptionOnly = true; r.DisplayAsDropDownListItem = true
  end) end
end
S.refreshPicker = refreshPicker

local function submit()
  local m = S.mem
  local req = readInteger(m + O.req)
  if req == 1 or req == 2 then status('Previous summon is still waiting for the game.'); return end
  refreshPicker(false)
  local idx = readInteger(m + O.uiItem)
  local it = idx and ITEMS[idx + 1]
  local f = readInteger(m + O.uiFaction) or 0
  local k = readInteger(m + O.uiKind) or 0
  if idx == -1 then status('This faction has no buildings. Set Category to Unit.'); return end
  if it == nil or it.k ~= k or (k ~= 2 and it.f ~= f) then status('Pick something in Summon.'); return end
  local n = readInteger(m + O.uiCount) or 1
  if n &lt; 1 then n = 1 elseif n &gt; 25 then n = 25 end
  local where = readInteger(m + O.uiWhere)
  if where ~= 1 and where ~= 2 then where = 0 end
  local owner = readInteger(m + O.uiOwner) or -1
  if OWNER_NAMES[owner] == nil then owner = -1 end
  if it.k ~= 2 and where == 2 then status('Into inventory is only for items. Set Where to At mouse cursor or At selected unit.'); return end
  if it.k == 2 and where ~= 2 and it.t &lt; 0 then status('This item has no ground object. Set Where to Into owner inventory.'); return end
  if it.k == 2 and where == 2 and it.v ~= 1 then status('This item does nothing in an inventory. Drop it on the ground instead.'); return end
  if it.k == 2 and where == 2 and owner &gt;= 8 then status('Only player slots 0-7 have an inventory. Pick another Owner.'); return end
  local ownerText = OWNER_NAMES[owner]
  if it.k == 2 and where ~= 2 then owner = -1; ownerText = 'the ground' end   -- ground items belong to nobody (player 9, like the game's own drops)
  writeInteger(m + O.kind, it.k)
  writeInteger(m + O.type, it.t)
  writeInteger(m + O.count, n)
  writeInteger(m + O.where, where)
  writeInteger(m + O.owner, owner)
  writeFloat(m + O.spacing, (it.k == 1 and BUILDING_SPACING) or (it.k == 2 and ITEM_SPACING) or UNIT_SPACING)
  writeInteger(m + O.itemId, it.k == 2 and it.i or -1)
  writeInteger(m + O.nameTE, it.k == 2 and it.n or -1)
  writeInteger(m + O.res, 0)
  S.reqName = it.l; S.reqCount = n; S.reqOwner = ownerText; S.reqKind = it.k; S.reqWhere = where
  S.reqTime = getTickCount(); S.reqHits = readInteger(m + O.hits)
  writeInteger(m + O.req, 1)                -- publish last
  if it.k == 2 and where == 2 then status('Giving ' .. n .. ' x ' .. S.reqName .. ' to ' .. S.reqOwner .. ' ...')
  elseif it.k == 2 then status('Dropping ' .. n .. ' x ' .. S.reqName .. ' on the ground ...')
  else status('Summoning ' .. n .. ' x ' .. S.reqName .. ' for ' .. S.reqOwner .. ' ...') end
end

-- Summon Key and Level Up Key. The callbacks only raise a flag; all memory work happens on the timer.
local function bindKey()
  if S.hotkey then local h = S.hotkey; S.hotkey = nil; pcall(function() h.destroy() end) end
  if S.lvHotkey then local h = S.lvHotkey; S.lvHotkey = nil; pcall(function() h.destroy() end) end
  local vk = readInteger(S.mem + O.uiKey) or 0
  local lk = readInteger(S.mem + O.uiLvKey) or 0
  S.boundKey = vk; S.boundLvKey = lk
  if KEY_NAMES[vk] == nil then vk = 0 end
  if KEY_NAMES[lk] == nil then lk = 0 end
  S.keyClash = (vk ~= 0 and vk == lk)
  if vk ~= 0 then
    S.hotkey = createHotkey(function() S.want = true end, vk)
    pcall(function() S.hotkey.DelayBetweenActivate = 350 end)
  end
  if lk ~= 0 and not S.keyClash then
    S.lvHotkey = createHotkey(function() S.wantLv = true end, lk)
    pcall(function() S.lvHotkey.DelayBetweenActivate = 350 end)
  end
  if S.keyClash then status('Summon Key and Level Up Key are the same key. Pick a different Level Up Key.') end
end

-- Level Up: the game's own mission-script call UnitSetLevel(unit id, level), run on the game thread for every
-- selected captain of yours. The current level is read exactly like the game's unit panel does it: the unit's
-- UnitLevels row (+0xAF4) through the game's own row getter, Level at row +0x10. The game levels a captain TYPE for its owner (it grants that type's level upgrades,
-- the same ones the upgrade buildings sell), so all your captains of that type reach the level.
local UNIT_NAMES = {}
for _, it in ipairs(ITEMS) do if it.k == 0 and UNIT_NAMES[it.t] == nil then UNIT_NAMES[it.t] = it.l end end
local function plural(n, one, many) if n == 1 then return '1 ' .. one end return n .. ' ' .. many end
local function levelUp()
  if not S.enabled or S.mem == nil then status('Tick Deity Zenith - Enable first, then use Level Up.'); return end
  if not processAlive() then abandon(GONE); return end
  local m = S.mem
  local req = readInteger(m + O.req)
  if req == 1 or req == 2 then status('Previous request is still waiting for the game.'); return end
  local lv = readInteger(m + O.uiLevel)
  if LEVEL_NAMES[lv] == nil then status('Pick a Captain Level first.'); return end
  writeInteger(m + O.kind, 3)
  writeInteger(m + O.type, lv)
  writeInteger(m + O.count, 1)
  writeInteger(m + O.where, 0)
  writeInteger(m + O.owner, -1)
  writeInteger(m + O.itemId, -1)
  writeInteger(m + O.nameTE, -1)
  writeInteger(m + O.res, 0)
  S.reqKind = 3; S.reqLevel = lv; S.reqName = 'Level Up'; S.reqCount = 1; S.reqWhere = 0; S.reqOwner = OWNER_NAMES[-1]
  S.reqTime = getTickCount(); S.reqHits = readInteger(m + O.hits)
  writeInteger(m + O.req, 1)                -- publish last
  status('Level Up to level ' .. lv .. ': waiting for the game (switch back to the game if it is minimized) ...')
end
S.levelUp = levelUp
S.status = status
local function levelStatus(res, made)
  local m = S.mem
  local lv = S.reqLevel
  local c = function(o) return readInteger(m + o) or 0 end
  local notes = {}
  if c(O.lvSame) == 1 then
    local t = c(O.lvSameType)
    notes[#notes + 1] = tostring(UNIT_NAMES[t] or ('type ' .. t)) .. ' is already level ' .. c(O.lvSameLv) .. ' (Level Up never lowers a level)'
  elseif c(O.lvSame) &gt; 1 then notes[#notes + 1] = c(O.lvSame) .. ' captains were already level ' .. lv .. ' or higher' end
  if c(O.lvChamp) &gt; 0 then notes[#notes + 1] = plural(c(O.lvChamp), 'hero', 'heroes') .. ' skipped (the game has no captain levels for heroes)' end
  if c(O.lvNotCap) &gt; 0 then notes[#notes + 1] = plural(c(O.lvNotCap), 'unit', 'units') .. ' skipped (not captains, or no level in the game data)' end
  if c(O.lvForeign) &gt; 0 then notes[#notes + 1] = plural(c(O.lvForeign), 'captain', 'captains') .. ' skipped (not yours)' end
  if c(O.lvFail) &gt; 0 then notes[#notes + 1] = plural(c(O.lvFail), 'captain', 'captains') .. ' not levelled by the game (dying or busy)' end
  local tail = (#notes &gt; 0) and ('; ' .. table.concat(notes, '; ')) or ''
  if res == 1 then
    local done, seen = {}, {}
    local n = c(O.lvNTypes); if n &gt; 8 then n = 8 end
    for i = 0, n - 1 do
      local t = c(O.lvTypes + 4 * i)
      if not seen[t] then seen[t] = true; done[#done + 1] = tostring(UNIT_NAMES[t] or ('type ' .. t)) .. ' now level ' .. c(O.lvLevels + 4 * i) end
    end
    return 'Level Up: ' .. table.concat(done, ', ') .. ' (the game levels every captain of that kind you own)' .. tail
  elseif res == 14 then return 'Level Up: nothing levelled' .. tail
  elseif res == 7 then return 'Level Up: nothing selected. Select one or more of your captains first.'
  elseif res == 5 then return 'Level Up: the game is not ready (load a battle first).'
  elseif res == 3 then return 'Level Up is off in multiplayer and while a save is loading.'
  end
  return RESULTS[res] or ('Result ' .. tostring(res))
end

-- Make the long Summon names readable: widen Cheat Engine's address-list Value column to fit the longest
-- dropdown entry. Cosmetic only, CE side only; any CE version without these properties just skips it.
local function widenValueColumn()
  local al_ = al()
  local secs = al_.Header.Sections
  local n = secs.Count
  local function sec(i) local ok, v = pcall(function() return secs.getItem(i) end); if ok and v then return v end return secs.Items[i] end
  local col = nil
  for i = 0, n - 1 do local x = sec(i); local ok, t = pcall(function() return x.Text end); if ok and t == 'Value' then col = x end end
  if col == nil and n &gt;= 5 then col = sec(4) end
  if col == nil then return end
  local longest = ''
  local function consider(t) if type(t) == 'string' and #t &gt; #longest then longest = t end end
  for _, it in ipairs(ITEMS) do consider(it.l) end
  for _, t in pairs(OWNER_NAMES) do consider(t) end
  for _, t in pairs(KEY_NAMES) do consider(t) end
  for _, t in pairs(LEVEL_NAMES) do consider(t) end
  for _, t in ipairs(FACTIONS) do consider(t) end
  local w = nil
  pcall(function() w = getMainForm().Canvas.getTextWidth(longest) end)
  if type(w) ~= 'number' or w &lt;= 0 then w = #longest * 8 end
  w = math.floor(w + 48)                       -- room for the cell padding and the dropdown arrow
  if w &gt; 1000 then w = 1000 end
  if (col.Width or 0) &lt; w then col.Width = w end
end
S.widenValueColumn = widenValueColumn

local function step()
  local m = S.mem
  local vk = readInteger(m + O.uiKey) or 0
  if vk ~= S.boundKey or (readInteger(m + O.uiLvKey) or 0) ~= S.boundLvKey then bindKey() end
  refreshPicker(false)
  updateResources()
  updateBackground()
  local req = readInteger(m + O.req)
  if req == 3 then
    writeInteger(m + O.req, 0)
    local res = readInteger(m + O.res) or 0
    local made = readInteger(m + O.made) or 0
    if S.reqKind == 3 then
      status(levelStatus(res, made))
    elseif res == 1 then
      local t
      if S.reqKind == 2 and S.reqWhere == 2 then t = 'Gave ' .. made .. ' x ' .. tostring(S.reqName) .. ' to ' .. tostring(S.reqOwner)
      elseif S.reqKind == 2 then t = 'Dropped ' .. made .. ' x ' .. tostring(S.reqName) .. ' on the ground'
      else t = 'Summoned ' .. made .. ' x ' .. tostring(S.reqName) .. ' for ' .. tostring(S.reqOwner) end
      if made &lt; (S.reqCount or made) then
        if S.reqKind == 2 and S.reqWhere == 2 then t = t .. ' - then the game took no more (inventory full)'
        else t = t .. ' - the game stopped after ' .. made end
      end
      status(t)
    else
      status(RESULTS[res] or ('Result ' .. tostring(res)))
    end
  elseif req == 1 and S.reqTime and getTickCount() - S.reqTime &gt; ((S.reqKind == 3) and 30000 or 4000) then
    local hits = readInteger(m + O.hits)
    if hits == S.reqHits then
      writeInteger(m + O.req, 0)
      if S.reqKind == 3 then status('The game did not run for 30 seconds (menu, loading or minimized). Level Up cancelled.')
      else status('The game is not running a battle (menu, loading or minimized). Summon cancelled.') end
    end
    S.reqTime = getTickCount(); S.reqHits = hits
  end
  if S.wantLv then
    S.wantLv = false
    if getForegroundProcess() ~= S.pid then status('Click into the game window, then press the Level Up Key.')
    else levelUp() end
  end
  if S.want then
    S.want = false
    if getForegroundProcess() ~= S.pid then status('Click into the game window, then press the summon key.')
    else submit() end
  end
end

local function tick()
  if not S.enabled then return end
  if not processAlive() then abandon(GONE); return end
  local ok, e = pcall(step)
  if not ok then
    if not processAlive() then abandon(GONE) else status('Error: ' .. tostring(e)) end
  end
end

local function fail(msg)
  status(msg)
  error('Deity Zenith: ' .. msg, 0)
end

local function enable()
  local pid = getProcessIDFromProcessName(EXE)
  if pid == nil or pid == 0 then fail('Start Dragonshard first, then tick Enable.') end
  if getOpenedProcessID() ~= pid then
    openProcess(pid)
    if getOpenedProcessID() ~= pid then fail('Cheat Engine could not attach to Dragonshard.exe.') end
  end
  S.pid = pid
  for _, s in ipairs(SIGS) do
    if not same(bytesAt(s[1], #s[2]), s[2]) then
      fail(string.format('This Dragonshard.exe is not the supported GOG 1.02.1.0 build (check at %08X).', s[1]))
    end
  end
  -- resident block: reuse when it is already in this process
  local mem = getAddressSafe(MEMSYM)
  if mem ~= nil then
    local ok, v = pcall(readInteger, mem)
    if not ok or v ~= MAGIC then pcall(unregisterSymbol, MEMSYM); mem = nil end
  end
  local cur = bytesAt(HOOK, 5)
  if mem == nil and cur ~= nil and cur[1] == 0xE9 then
    -- a block left in the game by a previous Cheat Engine session: adopt it if it is ours
    local rel = (cur[2] + cur[3] * 0x100 + cur[4] * 0x10000 + cur[5] * 0x1000000)
    local block = (HOOK + 5 + rel - CODE_OFF) % 0x100000000
    local ok, v = pcall(readInteger, block)
    if ok and v == MAGIC and same(cur, jmpBytes(HOOK, block + CODE_OFF)) then
      registerSymbol(MEMSYM, block, true)
      mem = block
    end
  end
  if mem == nil and cur ~= nil and cur[1] == 0xE9 then
    local rel = (cur[2] + cur[3] * 0x100 + cur[4] * 0x10000 + cur[5] * 0x1000000)
    local block = (HOOK + 5 + rel - CODE_OFF) % 0x100000000
    local ok, v = pcall(readInteger, block)
    if ok and OLD_MAGICS[v] then fail('An older Deity Zenith Dragonshard table is still switched on in this game. Turn it off first (untick Enable in that table, or restart the game), then tick this one.') end
  end
  if mem == nil then
    if not same(cur, HOOK_ORIG) then fail('The game code at the hook is already changed by another tool. Restart the game.') end
    local ok, r = pcall(autoAssemble, [[
