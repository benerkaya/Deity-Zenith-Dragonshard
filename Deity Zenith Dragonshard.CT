{$lua}
if syntaxcheck then return end
-- one-shot button: asks the Enable script to level the selected captains, then unticks itself
local mr = memrec
if DZDS6 and DZDS6.levelUp then local ok, e = pcall(DZDS6.levelUp); if not ok and DZDS6.status then pcall(DZDS6.status, 'Level Up error: ' .. tostring(e)) end
else local r = getAddressList().getMemoryRecordByID(30); if r then r.Description = 'Status: Tick Deity Zenith - Enable first, then use Level Up.' end end
local t = createTimer(nil, false)
t.Interval = 100
t.OnTimer = function() t.Enabled = false; t.destroy(); if mr then mr.Active = false end end
t.Enabled = true
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
{$asm}
