    if not ok or r ~= true then fail('Could not inject the summon code: ' .. tostring(r)) end
    mem = getAddressSafe(MEMSYM)
    if mem == nil then fail('Injected block not found.') end
    writeInteger(mem + O.uiFaction, DEFAULT_FACTION)
    writeInteger(mem + O.uiKind, 0)
    writeInteger(mem + O.uiItem, DEFAULT_PICK)
    writeInteger(mem + O.uiCount, 1)
    writeInteger(mem + O.uiWhere, 0)
    writeInteger(mem + O.uiOwner, -1)
    writeInteger(mem + O.uiKey, DEFAULT_KEY)
    writeInteger(mem + O.uiLvKey, DEFAULT_LV_KEY)
    writeInteger(mem + O.uiLevel, DEFAULT_LEVEL)
    for i, p in ipairs(OFFSETS) do
      writeFloat(mem + O.offs + (i - 1) * 8, p[1])
      writeFloat(mem + O.offs + (i - 1) * 8 + 4, p[2])
    end
    writeInteger(mem, MAGIC)
  else
    if not same(cur, HOOK_ORIG) and not same(cur, jmpBytes(HOOK, mem + CODE_OFF)) then
      fail('The game code at the hook is changed by another tool. Restart the game.')
    end
  end
  S.mem = mem
  writeInteger(mem + O.enabled, 0)
  writeInteger(mem + O.req, 0)
  if not same(bytesAt(HOOK, 5), jmpBytes(HOOK, mem + CODE_OFF)) then
    pause()
    local okw, ew = writeCode(HOOK, jmpBytes(HOOK, mem + CODE_OFF))
    unpause()
    if not okw or not same(bytesAt(HOOK, 5), jmpBytes(HOOK, mem + CODE_OFF)) then
      pause(); writeCode(HOOK, HOOK_ORIG); unpause()
      fail('Could not install the game-loop hook: ' .. tostring(ew))
    end
  end
  writeInteger(mem + O.enabled, 1)
  S.enabled = true; S.want = false; S.wantLv = false; S.boundKey = nil; S.boundLvKey = nil; S.lastFK = nil
  S.bgOn = 'unset'; S.sndOrig = nil
  pcall(updateBackground)
  bindKey()
  refreshPicker(true)
  S.timer = createTimer(nil, false)
  S.timer.Interval = 100
  S.timer.OnTimer = tick
  S.timer.Enabled = true
  local r = rootRec()
  if r then r.OnDestroy = function() if S.enabled then disable('Table closed.') end end end
  pcall(widenValueColumn)
  status('On. Pick Faction, Category (Unit, Building or Item) and Summon, put the game in focus and press the summon key. Gold, Dragonshards and XP can be edited under ---Resources---.')
end
S.enable = enable

rootRec()
enable()

